TZ=Europe/Vienna
BASE_DIR=/opt/homelab
CONFIG_DIR=/opt/homelab/configs
MEDIA_DIR=/opt/homelab/media

# Public hostname for WireGuard UI (set your real DNS name)
WG_HOST=change-me.example.com

HOMEPAGE_ALLOWED_HOSTS=192.168.178.11:3000,sol:3000,jellyfin.home:3000

# Immich paths (data stays under /opt/immich)
UPLOAD_LOCATION=/opt/immich/library
DB_DATA_LOCATION=/opt/immich/postgres
IMMICH_VERSION=v3
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_HOSTNAME=database
DB_PORT=5432

# Seafile
SEAFILE_SERVER_HOSTNAME=seafile.example.com
SEAFILE_SERVER_LETSENCRYPT=false

# n8n (proxied by Nginx Proxy Manager)
DOMAIN_NAME=example.com
SUBDOMAIN=n8n
GENERIC_TIMEZONE=Europe/Vienna
